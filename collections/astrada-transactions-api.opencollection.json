{
  "opencollection": "1.0.0",
  "info": {
    "name": "Astrada bank-accounts transactions API",
    "version": "2024-02-28"
  },
  "items": [
    {
      "info": {
        "name": "transactions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve transaction",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.astrada.co/transactions/:transactionId",
            "params": [
              {
                "name": "transactionId",
                "value": "9340721f-bdce-4afa-bd9d-26cceb9d2176",
                "type": "path"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://api.astrada.co/auth/realms/{accountId}/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Returns a transaction by its unique identifier, including details about the transaction's state and relevant transactional data.\n"
        },
        {
          "info": {
            "name": "List transactions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.astrada.co/transactions",
            "params": [
              {
                "name": "transactionMessageId",
                "value": "9a88aa0e-c1d3-4e70-b5e1-45ab64eb5aac",
                "type": "query"
              },
              {
                "name": "subaccountId",
                "value": "2fd4d402-b759-479c-87a6-58d85e345356",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "ZXhhbXBsZQ==",
                "type": "query",
                "description": "The cursor to use for pagination. Identifies your place on the list"
              },
              {
                "name": "cardId",
                "value": "8164683a-8d23-4421-9694-1a81fc9b9c37",
                "type": "query"
              },
              {
                "name": "limit",
                "value": "25",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "order",
                "value": "desc",
                "type": "query"
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "implicit",
              "authorizationUrl": "https://api.astrada.co/auth/realms/{accountId}/protocol/openid-connect/token",
              "credentials": {
                "clientId": "{{clientId}}"
              }
            }
          },
          "docs": "Returns a list of all transactions under the account.\n\nBy default, `GET /transactions` returns transactions ordered by the latest `createdAt`. You can combine the different filters as documented.\n\nThis endpoint supports [cursor-based pagination](https://docs.astrada.co/reference/pagination).\n"
        }
      ]
    }
  ],
  "bundled": true
}