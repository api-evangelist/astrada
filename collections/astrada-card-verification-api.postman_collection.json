          "name": "List a card's 3DS verifications",
          "request": {
            "name": "List a card's 3DS verifications",
            "description": {
              "content": "List the 3DS verifications for a card, most recent first. Use the optional `state`\nfilter (e.g. `state=failed`) to retrieve only failed verifications — each failed\nverification carries a `failureReason` explaining why it failed. This includes\ncards declined synchronously at creation (the `POST` returned `400`): those\nattempts are persisted as failed verifications with `currentStepId: null`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "card-verifications",
                "3ds"
              ],
              "host": [
