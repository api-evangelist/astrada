          "name": "Lookup card information by BIN",
          "request": {
            "name": "Lookup card information by BIN",
            "description": {
              "content": "Retrieve card information such as network, type, and issuing bank by providing the card's BIN (Bank Identification Number).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "bin-lookup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bin",
                  "value": "<string>",
                  "description": "(Required) The card's Bank Identification Number (BIN), consisting of the first 6 to 11 digits of the card number."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/hal+json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "accounts:write accounts:read subaccounts:write subaccounts:read card-connector-data-links:write card-connector-consents:read card-connector-consents:write webhooks:read webhooks:write card-subscriptions:write card-subscriptions:read card-verifications:write card-verifications:read cards:read cardholder:read cardholder:write transactions:read transaction-messages:read network-bulk-feeds:read network-bulk-feeds:write network-links:write enrollment-methods:write simulation:write banking:read banking:write banking:admin appstore:enrollment:write appstore:cards:read appstore:transactions:read appstore:transactions:sync appstore:sessions:read appstore:sessions:write appstore:tokens:read appstore:tokens:write"
                },
                {
                  "key": "redirect_uri",
                  "value": "https://api.astrada.co/auth/realms/{accountId}/protocol/openid-connect/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://api.astrada.co/auth/realms/{accountId}/protocol/openid-connect/token"
                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            }
          },
