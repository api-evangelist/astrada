                },
                {
                  "key": "grant_type",
                  "value": "implicit"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardId\": \"<uuid>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
