          "name": "List transaction matches",
          "request": {
            "name": "List transaction matches",
            "description": {
              "content": "Returns a list of transaction matches for a subaccount. Each match represents a link between a bank transaction and a card transaction, along with a confidence score and the reasoning behind the match.\n\nBy default, matches are filtered to `MEDIUM` confidence and above. Use the `minConfidence` parameter to adjust the threshold.\n\nBy default, `GET /transaction-matches/{subaccountId}` returns matches ordered by the latest `createdAt`.\n\nThis endpoint supports cursor-based pagination.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transaction-matches",
                ":subaccountId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "bankAccountId",
                  "value": "<uuid>",
                  "description": "Filter by bank account identifier"
                },
